APP_NAME="Luany Docs"
# development | production — production disables debug pages and live reload.
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_KEY=
APP_TIMEZONE=UTC
APP_LOCALE=en

# Documentation checkout (github.com/luany-ecosystem/docs).
# Defaults to the content/ submodule; relative paths resolve from the project root.
# DOCS_PATH=../docs
