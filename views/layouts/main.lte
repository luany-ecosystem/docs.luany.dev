    <script>
        (function () {
            var t = null;
            try { t = localStorage.getItem('luany-docs-theme'); } catch (e) {}
            if (t !== 'light' && t !== 'dark') {
                t = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
            }
            document.documentElement.dataset.theme = t;
            if (document.documentElement.dataset.page === 'landing' && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
                document.documentElement.classList.add('motion');
            }
        }());
    </script>
