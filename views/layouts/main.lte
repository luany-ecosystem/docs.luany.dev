    {{-- Appearance: resolve the theme before first paint (no flash). Pref: system | light | dark --}}
    <script>
        (function () {
            var d = document.documentElement, p = 'system';
            d.classList.add('js');
            try { p = localStorage.getItem('luany-theme') || 'system'; } catch (e) {}
            var dark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
            d.setAttribute('data-theme', p === 'system' ? (dark ? 'dark' : 'light') : p);
            d.setAttribute('data-theme-pref', p);
            if (window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches) d.classList.add('reduced-motion');
        }());
    </script>

    {{-- Open Graph --}}
    <meta property="og:type" content="website">
    <meta property="og:site_name" content="Luany">
    <meta property="og:title" content="@yield('title', 'Luany')">
