/* ── Hero ─────────────────────────────────────────────────────── */
.hero { padding-top: var(--nav-height); min-height: min(100vh, 980px); display: flex; flex-direction: column; }
.hero-body {
    position: relative; z-index: 2; flex: 1;
    display: grid; grid-template-columns: 1fr 1.05fr; gap: var(--space-12); align-items: center;
    padding-block: clamp(3rem, 7vw, 6rem);
}
.hero h1 { font-size: clamp(3rem, 1.6rem + 4.1vw, 5.4rem); letter-spacing: -.05em; line-height: .98; margin-bottom: var(--space-8); }
.hero h1 .accent { display: inline-block; background: var(--gradient-text); -webkit-background-clip: text; background-clip: text; color: transparent; padding-bottom: .08em; }
.hero-sub { font-size: clamp(1.1rem, 1rem + .5vw, 1.4rem); max-width: 34ch; color: rgba(255,255,255,.78); margin-bottom: var(--space-10); line-height: 1.5; }
.hero-actions { display: flex; flex-wrap: wrap; gap: var(--space-3); }
.hero-install {
    display: inline-flex; align-items: center; gap: .65rem; margin-top: var(--space-8);
    font-family: var(--font-mono); font-size: .85rem; color: rgba(255,255,255,.62);
}
.hero-install b { color: var(--brand-orange); font-weight: 500; }
.hero-install button { display: grid; place-items: center; width: 30px; height: 30px; border-radius: 8px; border: 1px solid rgba(255,255,255,.16); background: rgba(255,255,255,.05); color: rgba(255,255,255,.75); }
.hero-install button:hover { color: #fff; border-color: rgba(255,255,255,.4); }
.hero-install button.is-copied { color: #3ECF8E; border-color: #3ECF8E; }

/* ── Hero stage (floating product UI) ─────────────────────────── */
.dark-surface .mk { --color-heading: #0A0918; --color-text: #1A1726; --color-text-muted: #55516A; --color-border: #ECE6E0; }
[data-theme="dark"] .dark-surface .mk { --color-heading: #FFFFFF; --color-text: #E4DFEC; --color-text-muted: #A39DB8; --color-border: rgba(255,255,255,.09); }
.stage { position: relative; height: 540px; perspective: 1400px; }
.mk {
    position: absolute;
    background: var(--color-surface); color: var(--color-text);
    border: 1px solid var(--color-border);
    border-radius: 16px; box-shadow: 0 40px 80px -20px rgba(0,0,0,.6);
    font-size: .8rem; transform-style: preserve-3d; overflow: hidden;
}
.mk-editor { top: 10px; left: 0; width: 84%; }
.mk-titlebar { display: flex; align-items: center; gap: 14px; padding: 10px 14px; border-bottom: 1px solid var(--color-border); background: var(--color-bg-soft); }
.mk-dots { display: flex; gap: 6px; }
.mk-dots i { width: 10px; height: 10px; border-radius: 50%; background: var(--color-border-strong); }
.mk-tabs { display: flex; gap: 4px; font-family: var(--font-mono); font-size: .72rem; }
.mk-tabs span { display: inline-flex; align-items: center; gap: 6px; padding: 5px 10px; border-radius: 7px; color: var(--color-text-muted); }
.mk-tabs span.is-active { background: var(--color-surface); color: var(--color-heading); box-shadow: var(--shadow-sm); }
.mk-tabs img { width: 13px; height: 13px; }
.mk-body { display: grid; grid-template-columns: 150px 1fr; min-height: 290px; }
.mk-tree { padding: 12px 10px; border-right: 1px solid var(--color-border); background: var(--color-bg-soft); font-family: var(--font-mono); font-size: .7rem; color: var(--color-text-muted); }
.mk-tree p { display: flex; align-items: center; gap: 6px; padding: 3px 6px; border-radius: 5px; white-space: nowrap; }
.mk-tree p.d1 { padding-left: 16px; } .mk-tree p.d2 { padding-left: 28px; }
.mk-tree p.is-active { background: var(--color-accent-soft); color: var(--color-heading); }
.mk-tree img { width: 12px; height: 12px; }
.mk-tree svg { opacity: .6; }
.mk-code { margin: 0; padding: 14px 16px; font-family: var(--font-mono); font-size: .74rem; line-height: 1.85; white-space: pre; overflow: hidden; color: var(--color-text); }
.mk-code .ln { display: block; }
.mk-code .n { display: inline-block; width: 22px; color: var(--color-text-faint); }
.mk-code .k { color: #8E3FB5; } .mk-code .s { color: #C2461A; } .mk-code .v { color: #2F6BB3; } .mk-code .t { color: #B03A5B; }
[data-theme="dark"] .mk-code .k { color: #C79BEA; } [data-theme="dark"] .mk-code .s { color: #FDB37A; } [data-theme="dark"] .mk-code .v { color: #8FB8FF; } [data-theme="dark"] .mk-code .t { color: #FF8F9B; }
.mk-status { display: flex; gap: 16px; padding: 7px 14px; border-top: 1px solid var(--color-border); font-family: var(--font-mono); font-size: .68rem; color: var(--color-text-muted); background: var(--color-bg-soft); }
.mk-status .ok { color: var(--green); font-weight: 600; }

.mk-term {
    right: -10px; top: 270px; width: 290px;
    background: #05061A; border-color: rgba(255,255,255,.12); color: #D2CCE2;
    font-family: var(--font-mono); font-size: .72rem;
}
.mk-term-bar { display: flex; align-items: center; gap: 8px; padding: 9px 12px; border-bottom: 1px solid rgba(255,255,255,.08); color: #8E88A8; }
.mk-term-bar .mk-dots i { background: #2D2A55; }
.mk-term-body { padding: 12px 14px 14px; line-height: 1.9; }
.mk-term .ln { display: block; white-space: nowrap; }
.mk-term .p { color: #FD962F; } .mk-term .ok { color: #3ECF8E; } .mk-term .dim { color: #8E88A8; } .mk-term .hl { color: #C79BEA; }

.mk-toast {
    left: 26%; bottom: 26px; display: flex; align-items: center; gap: 12px;
    padding: 12px 16px; border-radius: 14px; opacity: 0;
}
.reduced-motion .mk-toast { opacity: 1; }
.mk-toast .ok { width: 32px; height: 32px; border-radius: 50%; display: grid; place-items: center; background: var(--green); color: #fff; }
.mk-toast strong { display: block; font-family: var(--font-display); color: var(--color-heading); font-size: .85rem; }
.mk-toast span { color: var(--color-text-muted); font-size: .75rem; }

/* ── Marquee ─────────────────────────────────────────────────── */
.marquee { border-bottom: 1px solid var(--color-border); overflow: hidden; padding-block: var(--space-8); background: var(--color-bg); }
.marquee-track { display: flex; gap: var(--space-12); width: max-content; animation: marquee 42s linear infinite; }
.marquee:hover .marquee-track { animation-play-state: paused; }
.marquee-item {
    display: inline-flex; align-items: center; gap: var(--space-3);
    font-family: var(--font-display); font-size: clamp(1.2rem, 1rem + .8vw, 1.7rem); font-weight: 700; letter-spacing: -.02em;
    color: var(--color-text-faint); white-space: nowrap;
}
.marquee-item svg { color: var(--color-accent); }
@keyframes marquee { to { transform: translateX(-50%); } }

/* ── Pillars ─────────────────────────────────────────────────── */
.pillars { display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--space-6); }
.pillar { padding: 0; overflow: hidden; }
.pillar-visual { background: var(--color-bg-soft); padding: var(--space-6) var(--space-5) var(--space-4); border-bottom: 1px solid var(--color-border); }
.pillar-body { padding: clamp(1.5rem, 2.6vw, 2.25rem); display: flex; flex-direction: column; gap: var(--space-4); flex: 1; }
.pillar-num { font-family: var(--font-mono); font-size: .8rem; color: var(--color-text-faint); }
.pillar h3 { font-size: clamp(1.6rem, 1.2rem + 1vw, 2.1rem); }
.pillar p { color: var(--color-text-muted); font-size: 1.05rem; }
.pillar ul { list-style: none; display: grid; gap: .1rem; margin-top: auto; padding-top: var(--space-4); border-top: 1px solid var(--color-border); }
.pillar li a { display: flex; justify-content: space-between; align-items: center; padding: .55rem 0; font-weight: 600; color: var(--color-heading); }
.pillar li a svg { color: var(--color-accent); opacity: 0; transform: translateX(-6px); transition: all var(--transition); }
.pillar li a:hover { color: var(--color-accent); }
.pillar li a:hover svg { opacity: 1; transform: none; }

/* ── Tools ───────────────────────────────────────────────────── */
.prod-grid { display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-6); }
.prod-card { padding: 0; overflow: hidden; display: grid; }
.prod-card--wide { grid-column: 1 / -1; grid-template-columns: 1fr 1.15fr; align-items: center; }
.prod-card--wide .prod-visual { padding: var(--space-10) var(--space-10) var(--space-10) 0; }
.prod-text { padding: clamp(1.75rem, 3.5vw, 3rem); display: flex; flex-direction: column; gap: var(--space-4); align-items: flex-start; }
.prod-text h3 { font-size: clamp(1.7rem, 1.2rem + 1.4vw, 2.6rem); }
.prod-text p { color: var(--color-text-muted); font-size: 1.08rem; }
.prod-visual { padding: 0 var(--space-6) var(--space-6); perspective: 1200px; }

/* ── Process ─────────────────────────────────────────────────── */
.process { position: relative; display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-8); list-style: none; padding-top: var(--space-12); }
.process-track, .process-line { position: absolute; top: 18px; left: 0; right: 0; height: 2px; border-radius: 2px; }
.process-track { background: var(--color-border); }
.process-line { background: var(--gradient-line); transform-origin: 0 50%; }
.process-step { position: relative; }
.process-step::before {
    content: ''; position: absolute; top: calc(-1 * var(--space-12) + 10px); left: 0;
    width: 18px; height: 18px; border-radius: 50%;
    background: var(--color-bg); border: 2px solid var(--color-border-strong);
    transition: background .3s, border-color .3s, box-shadow .3s;
}
.process-step.is-active::before, .reduced-motion .process-step::before { background: var(--brand-ember); border-color: var(--brand-ember); box-shadow: 0 0 0 6px var(--color-accent-soft); }
.process-step .n { font-family: var(--font-mono); font-size: .8rem; color: var(--color-accent); }
.process-step h3 { font-size: 1.5rem; margin: var(--space-2) 0 var(--space-3); }
.process-step code { display: inline-block; margin-bottom: var(--space-3); padding: .3rem .6rem; border-radius: 8px; background: var(--inline-code-bg); color: var(--inline-code); font-size: .8rem; }
.process-step p { color: var(--color-text-muted); }

/* ── Stat slider ─────────────────────────────────────────────── */
.stats { padding-block: clamp(4rem, 8vw, 6rem) clamp(8rem, 14vw, 12rem); }
.stats .container { position: relative; z-index: 2; }
.stats-top { display: flex; justify-content: space-between; align-items: center; }
.stats-count { font-family: var(--font-display); font-weight: 700; color: #fff; }
.stats-count span { color: rgba(255,255,255,.35); }
.round-btn {
    width: 44px; height: 44px; border-radius: 50%; display: inline-grid; place-items: center;
    border: 1px solid rgba(255,255,255,.2); background: rgba(255,255,255,.08); color: #fff;
    transition: background var(--transition);
}
.round-btn:hover { background: rgba(255,255,255,.18); }
.round-btn:disabled { opacity: .35; cursor: default; }
.stats-slides { position: relative; min-height: 320px; text-align: center; }
.stat { position: absolute; inset: 0; display: grid; place-content: center; gap: var(--space-4); }
.stat-value {
    font-family: var(--font-display); font-weight: 800; line-height: 1;
    font-size: clamp(6rem, 3rem + 12vw, 13rem); letter-spacing: -.06em;
    background: linear-gradient(92deg, #B78BE0, #E9714D 50%, #FDA14A);
    -webkit-background-clip: text; background-clip: text; color: transparent;
    font-variant-numeric: tabular-nums;
}
.stat p { font-size: clamp(1.15rem, 1rem + .6vw, 1.6rem); color: rgba(255,255,255,.85); max-width: 30ch; margin-inline: auto; }
.stats-dots { display: flex; justify-content: center; gap: 8px; margin-top: var(--space-6); }
.stats-dots button { width: 34px; height: 3px; border: 0; border-radius: 2px; background: rgba(255,255,255,.25); }
.stats-dots button.is-active { background: #fff; }

/* ── Ecosystem carousel ──────────────────────────────────────── */
.carousel-head { display: flex; justify-content: space-between; align-items: flex-end; gap: var(--space-6); margin-bottom: var(--space-10); }
.carousel-head .section-title { margin: 0; max-width: 18ch; }
.carousel-nav { display: flex; gap: var(--space-2); align-items: center; }
.carousel-nav .count { font-family: var(--font-display); font-weight: 700; margin-right: var(--space-3); color: var(--color-heading); }
.carousel-nav .count span { color: var(--color-text-faint); }
.carousel-nav .round-btn { background: var(--color-accent-soft); color: var(--color-accent); border-color: transparent; }
.track {
    display: grid; grid-auto-flow: column; grid-auto-columns: min(78vw, 400px); gap: var(--space-6);
    overflow-x: auto; scroll-snap-type: x mandatory; scrollbar-width: none;
    padding: var(--space-2) var(--gutter) var(--space-6);
    margin-inline: calc(-1 * var(--gutter));
    scroll-padding-inline: var(--gutter);
}
.track::-webkit-scrollbar { display: none; }
.pkg { scroll-snap-align: start; min-height: 340px; border-top: 6px solid var(--brand-violet); box-shadow: var(--shadow-md); }
.pkg:nth-child(3n+2) { border-top-color: var(--brand-coral); }
.pkg:nth-child(3n)   { border-top-color: var(--brand-orange); }
.pkg h3 { font-size: 1.5rem; margin-top: var(--space-4); font-family: var(--font-mono); letter-spacing: -.03em; }
.pkg p { color: var(--color-text-muted); font-size: 1.05rem; }
.pkg-foot { margin-top: auto; padding-top: var(--space-6); border-top: 1px solid var(--color-border); display: flex; flex-wrap: wrap; align-items: center; gap: var(--space-2); }
.pkg-foot .links { margin-left: auto; display: flex; gap: var(--space-4); font-weight: 600; font-size: .9rem; }
.pkg-foot .links a { color: var(--color-accent); }

/* ── CTA ─────────────────────────────────────────────────────── */
.cta { text-align: center; padding-block: clamp(5rem, 10vw, 8rem) clamp(7rem, 12vw, 10rem); }
.cta .container { position: relative; z-index: 2; }
.cta h2 { font-size: var(--text-5xl); letter-spacing: -.045em; line-height: 1; max-width: 17ch; margin: 0 auto var(--space-6); }
.cta p { font-size: clamp(1.05rem, 1rem + .4vw, 1.3rem); color: rgba(255,255,255,.72); max-width: 44ch; margin: 0 auto var(--space-10); }
.cta .hero-actions { justify-content: center; }

@media (max-width: 1080px) {
    .hero-body { grid-template-columns: 1fr; }
    .stage { height: 480px; max-width: 680px; }
    .pillars { grid-template-columns: 1fr; }
    .prod-grid, .prod-card--wide { grid-template-columns: 1fr; }
    .prod-card--wide .prod-visual { padding: 0 var(--space-6) var(--space-6); }
    .process { grid-template-columns: 1fr 1fr; row-gap: var(--space-12); }
    .process-track, .process-line { display: none; }
}
@media (max-width: 760px) {
    .stage { height: 430px; }
    .mk-editor { width: 100%; }
    .mk-body { grid-template-columns: 1fr; }
    .mk-tree { display: none; }
    .mk-term { width: 240px; top: 250px; right: -8px; }
    .mk-toast { left: 0; bottom: 0; }
    .process { grid-template-columns: 1fr; }
    .carousel-head { flex-direction: column; align-items: flex-start; }
}
@endstyle

