        <nav class="pager">
            @if($page['prev'])
                <a class="prev" href="/{{ $locale }}/docs/{{ $page['prev']['slug'] }}"><small>← {{ $t['ui']['previous'] }}</small>{{ $page['prev']['title'] }}</a>
            @endif
            @if($page['next'])
                <a class="next" href="/{{ $locale }}/docs/{{ $page['next']['slug'] }}"><small>{{ $t['ui']['next'] }} →</small>{{ $page['next']['title'] }}</a>
