                        <li><a href="/{{ $locale }}/docs/{{ $item['slug'] }}" @class(['active' => $item['slug'] === $page['slug']])>{{ $item['title'] }}</a></li>
                    @endforeach
                </ul>
            @endforeach
        </nav>
    </aside>
    <div class="sidebar-scrim" data-toggle-sidebar></div>

    <main id="main" class="content">
