        <p class="edit"><a href="{{ $editUrl }}" target="_blank" rel="noopener">
            {!! icon('edit', 16, 1.8) !!}
            {{ $t['ui']['edit'] }}
        </a></p>
    </main>

    <aside class="outline">
        @if($page['outline'] !== [])
