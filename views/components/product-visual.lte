{{-- Tool visuals. Usage: @include('components.product-visual', ['tool' => 'cli|vscode|ci']) — animated in illustrations.js --}}
@style
.pv { position: relative; width: 100%; }
.pv-code {
    border-radius: 16px; overflow: hidden;
    background: #0A0B26; color: #D2CCE2;
    border: 1px solid rgba(255,255,255,.08);
    box-shadow: var(--shadow-lg);
    font-family: var(--font-mono); font-size: clamp(.7rem, .62rem + .3vw, .86rem); line-height: 1.75;
}
.pv-bar { display: flex; align-items: center; gap: 8px; padding: 12px 16px; background: #0E1033; border-bottom: 1px solid rgba(255,255,255,.06); }
.pv-bar i { width: 10px; height: 10px; border-radius: 50%; background: #2D2A55; display: block; }
.pv-tab { display: inline-flex; align-items: center; gap: 6px; margin-left: 12px; padding: 4px 12px; border-radius: 8px; background: #0A0B26; color: #A49CC0; font-size: .78em; }
.pv-tab img { width: 13px; height: 13px; }
.pv-code pre { margin: 0; padding: 18px 20px 8px; white-space: pre; overflow: hidden; font: inherit; }
.pv-code .ln { display: block; }
.pv-code .k { color: #C79BEA; } .pv-code .s { color: #FDB37A; } .pv-code .v { color: #FF8F6B; } .pv-code .c { color: #6B6590; } .pv-code .t { color: #8FB8FF; }
.pv-term { margin: 8px 14px 14px; padding: 12px 14px; border-radius: 10px; background: #05061A; border: 1px solid rgba(255,255,255,.06); }
.pv-term .ln { display: block; }
.pv-term .ok { color: #3ECF8E; }
.pv-term .p  { color: #FD962F; }
.caret { display: inline-block; width: .55em; height: 1.1em; vertical-align: -.2em; background: #FD962F; animation: blink 1s steps(2) infinite; }
@keyframes blink { 50% { opacity: 0; } }
@endstyle

